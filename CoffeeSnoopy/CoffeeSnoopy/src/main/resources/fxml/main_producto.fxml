<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.CafeSnoopy.control.ProductoController">

    <top>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #2ecc71;">
            <Label text="📦 GESTIÓN DE PRODUCTOS - CAFE SNOOPY"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Administre el inventario de productos de la cafetería"
                   style="-fx-font-size: 14px; -fx-text-fill: #ecf0f1;"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="📝 Registrar Producto">
                <content>
                    <ScrollPane fitToWidth="true" fitToHeight="true">
                        <VBox spacing="20" style="-fx-padding: 20;">
                            <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-border-color: #bdc3c7; -fx-border-radius: 15;">
                                <Label text="📋 INFORMACIÓN DEL PRODUCTO" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                                <GridPane hgap="20" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="150"/>
                                        <ColumnConstraints prefWidth="300"/>
                                        <ColumnConstraints prefWidth="150"/>
                                        <ColumnConstraints prefWidth="300"/>
                                    </columnConstraints>

                                    <Label text="🔢 Código *:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtCodigo" promptText="Ej: PROD-001" style="-fx-font-size: 14px; -fx-pref-height: 35;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                    <Label text="🏷️ Nombre *:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtNombre" promptText="Nombre del producto" style="-fx-font-size: 14px; -fx-pref-height: 35;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                    <Label text="📝 Descripción:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="txtDescripcion" promptText="Descripción del producto" style="-fx-font-size: 14px; -fx-pref-height: 35;" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3"/>

                                    <Label text="💰 Precio *:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <TextField fx:id="txtPrecio" promptText="0.00" style="-fx-font-size: 14px; -fx-pref-height: 35;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                    <Label text="📊 Stock *:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                    <TextField fx:id="txtStock" promptText="0" style="-fx-font-size: 14px; -fx-pref-height: 35;" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                                    <Label text="✅ Estado:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                    <CheckBox fx:id="chkEstado" text="Producto activo" style="-fx-font-size: 14px; -fx-text-fill: #27ae60;" selected="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                    <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="3">
                                        <Button text="💾 GUARDAR" onAction="#guardarProducto"
                                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8;"/>
                                        <Button text="🔄 CANCELAR" onAction="#cancelarEdicion"
                                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 8;"/>
                                        <Button text="🧹 LIMPIAR" onAction="#limpiarFormulario"
                                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 8;"/>
                                    </HBox>
                                </GridPane>
                            </VBox>

                            <VBox spacing="15">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="📊 PRODUCTOS REGISTRADOS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <Label text="(Gestione sus productos aquí)" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                                </HBox>

                                <TableView fx:id="tableProductos" prefHeight="350" style="-fx-font-size: 13px;">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </content>
            </Tab>

            <Tab text="📈 Estadísticas">
                <content>
                    <ScrollPane fitToWidth="true" fitToHeight="true">
                        <VBox spacing="25" style="-fx-padding: 25;">
                            <Label text="📊 ESTADÍSTICAS DE PRODUCTOS" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                            <HBox spacing="20" alignment="CENTER">
                                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 25; -fx-background-color: #e8f6f3; -fx-background-radius: 12; -fx-pref-width: 220;">
                                    <Label text="📦 TOTAL" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <Label fx:id="lblTotalProductos" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                    <Label text="productos" style="-fx-text-fill: #7f8c8d;"/>
                                </VBox>

                                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 25; -fx-background-color: #fef9e7; -fx-background-radius: 12; -fx-pref-width: 220;">
                                    <Label text="💰 VALOR TOTAL" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <Label fx:id="lblValorTotal" text="S/ 0.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                                    <Label text="en inventario" style="-fx-text-fill: #7f8c8d;"/>
                                </VBox>

                                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 25; -fx-background-color: #eaf2f8; -fx-background-radius: 12; -fx-pref-width: 220;">
                                    <Label text="⚠️ STOCK BAJO" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <Label fx:id="lblStockBajo" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                    <Label text="productos" style="-fx-text-fill: #7f8c8d;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #ecf0f1; -fx-border-radius: 12;">
                                <Label text="ℹ️ INFORMACIÓN DEL INVENTARIO" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <GridPane hgap="20" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="250"/>
                                        <ColumnConstraints prefWidth="250"/>
                                    </columnConstraints>
                                    <Label text="• Estado: Conectado" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <Label text="• Almacén principal" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="• Actualización: Automática" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                </GridPane>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox spacing="15" style="-fx-padding: 12; -fx-background-color: #27ae60; -fx-alignment: CENTER_LEFT;">
            <Label text="🟢 Inventario activo" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
            <Label text="👤 Usuario: Admin" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>